{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onyx-foss.local/schemas/model-artifact-manifest-v1.json",
  "title": "Onyx FOSS Kotlin model artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_name",
    "artifact_format",
    "onnx_model_path",
    "tokenizer_path",
    "pooling",
    "embedding_dimension",
    "max_context_length",
    "model_sha256",
    "tokenizer_sha256",
    "source_commit",
    "license"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "model_name": { "type": "string", "minLength": 1 },
    "artifact_format": { "enum": ["onnx", "openvino"] },
    "onnx_model_path": { "type": "string", "minLength": 1 },
    "model_binary_path": { "type": ["string", "null"] },
    "tokenizer_path": { "type": "string", "minLength": 1 },
    "pooling": { "enum": ["mean", "cls", "last_token"] },
    "embedding_dimension": { "type": "integer", "minimum": 1 },
    "max_context_length": { "type": "integer", "minimum": 1 },
    "model_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_binary_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "tokenizer_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_commit": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 }
  }
}
